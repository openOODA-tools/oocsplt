// # oocsplt Pattern Parser
//
// Logline: Parses POSIX csplit pattern specifications including line numbers, delimiters, offsets, and repeat counts.
//
// Setup: Transforms string argument sequences into normalized SplitPattern records.
//
// Beats:
//   1. Convert numeric and signed strings to integers.
//   2. Parse regex delimiter syntax with optional offset modifiers.
//   3. Handle skip delimiters and repetition multipliers.
//   4. Format chunk filenames with configurable zero-padded digit widths.

import "core/split_types.oo";

pub fn parse_int(s: String) -> Int {
    let n: Int = chars_len(s);
    if n == 0 {
        return 0;
    }
    let mut val: Int = 0;
    let mut i: Int = 0;
    let mut sign: Int = 1;
    let first: Int = byte_at(s, 0);
    if first == 45 {
        sign = -1;
        i = 1;
    } else if first == 43 {
        i = 1;
    }
    while i < n {
        let ch: Int = byte_at(s, i);
        if ch >= 48 && ch <= 57 {
            val = val * 10 + (ch - 48);
        }
        i = i + 1;
    }
    return val * sign;
}

pub fn is_all_digits(s: String) -> Bool {
    let n: Int = chars_len(s);
    if n == 0 {
        return false;
    }
    let mut i: Int = 0;
    while i < n {
        let ch: Int = byte_at(s, i);
        if ch < 48 || ch > 57 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn format_chunk_filename(prefix: String, digits: Int, index: Int) -> String {
    let mut num_str: String = to_string(index);
    while chars_len(num_str) < digits {
        num_str = "0" + num_str;
    }
    return prefix + num_str;
}

fn parse_offset(suffix: String) -> Int {
    if chars_len(suffix) == 0 {
        return 0;
    }
    return parse_int(suffix);
}

pub fn parse_pattern_list(tokens: List[String]) -> List[SplitPattern] {
    let mut patterns: List[SplitPattern] = list_new();
    let num_tokens: Int = list_len(tokens);
    let mut i: Int = 0;

    while i < num_tokens {
        let tok: String = list_get(tokens, i);
        let n: Int = chars_len(tok);

        if n > 2 && byte_at(tok, 0) == 123 && byte_at(tok, n - 1) == 125 {
            // Repetition modifier: {N} or {*}
            let inside: String = str_slice(tok, 1, n - 1);
            let rep: Int = if inside == "*" { -1 } else { parse_int(inside) };
            let count: Int = list_len(patterns);
            if count > 0 {
                let last: SplitPattern = list_get(patterns, count - 1);
                let updated: SplitPattern = SplitPattern {
                    kind: last.kind,
                    text: last.text,
                    line_num: last.line_num,
                    offset: last.offset,
                    repeat: rep,
                    is_skip: last.is_skip
                };
                let mut new_pats: List[SplitPattern] = list_new();
                let mut j: Int = 0;
                while j < count - 1 {
                    new_pats = list_push(new_pats, list_get(patterns, j));
                    j = j + 1;
                }
                patterns = list_push(new_pats, updated);
            }
        } else if n > 1 && byte_at(tok, 0) == 47 {
            // Delimiter pattern: /PATTERN/[OFFSET]
            let mut close_idx: Int = -1;
            let mut j: Int = 1;
            while j < n {
                if byte_at(tok, j) == 47 {
                    close_idx = j;
                    j = n;
                }
                j = j + 1;
            }
            if close_idx > 0 {
                let pat: String = str_slice(tok, 1, close_idx);
                let suffix: String = if close_idx + 1 < n {
                    str_slice(tok, close_idx + 1, n)
                } else {
                    ""
                };
                let off: Int = parse_offset(suffix);
                patterns = list_push(patterns, SplitPattern {
                    kind: "pattern",
                    text: pat,
                    line_num: 0,
                    offset: off,
                    repeat: 1,
                    is_skip: false
                });
            } else {
                let pat: String = str_slice(tok, 1, n);
                patterns = list_push(patterns, SplitPattern {
                    kind: "pattern",
                    text: pat,
                    line_num: 0,
                    offset: 0,
                    repeat: 1,
                    is_skip: false
                });
            }
        } else if n > 1 && byte_at(tok, 0) == 37 {
            // Skip pattern: %PATTERN%[OFFSET]
            let mut close_idx: Int = -1;
            let mut j: Int = 1;
            while j < n {
                if byte_at(tok, j) == 37 {
                    close_idx = j;
                    j = n;
                }
                j = j + 1;
            }
            if close_idx > 0 {
                let pat: String = str_slice(tok, 1, close_idx);
                let suffix: String = if close_idx + 1 < n {
                    str_slice(tok, close_idx + 1, n)
                } else {
                    ""
                };
                let off: Int = parse_offset(suffix);
                patterns = list_push(patterns, SplitPattern {
                    kind: "skip",
                    text: pat,
                    line_num: 0,
                    offset: off,
                    repeat: 1,
                    is_skip: true
                });
            } else {
                let pat: String = str_slice(tok, 1, n);
                patterns = list_push(patterns, SplitPattern {
                    kind: "skip",
                    text: pat,
                    line_num: 0,
                    offset: 0,
                    repeat: 1,
                    is_skip: true
                });
            }
        } else if is_all_digits(tok) {
            // Line number split: e.g. 10, 20
            let ln: Int = parse_int(tok);
            patterns = list_push(patterns, SplitPattern {
                kind: "line",
                text: tok,
                line_num: ln,
                offset: 0,
                repeat: 1,
                is_skip: false
            });
        } else {
            // Fallback plain substring pattern
            patterns = list_push(patterns, SplitPattern {
                kind: "pattern",
                text: tok,
                line_num: 0,
                offset: 0,
                repeat: 1,
                is_skip: false
            });
        }
        i = i + 1;
    }

    return patterns;
}
