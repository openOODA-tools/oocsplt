// # oocsplt Streaming MCP Server
//
// Logline: JSON-RPC 2.0 stdio server exposing context splitting, boundary preview, and section inspection tools.
//
// Setup: Bridges standard input/output streaming JSON-RPC to the split engine using bounded capability tokens.
//
// Beats:
//   1. Handle MCP initialize handshake with server metadata.
//   2. Expose tools/list catalogue with five sovereign split inspection tools.
//   3. Dispatch tools/call for csplt_split, csplt_preview, csplt_by_lines, csplt_by_pattern, and csplt_demo.
//   4. Deliver streaming JSON-RPC responses over standard output.

import "core/split_types.oo";
import "core/pattern_parser.oo";
import "core/split_engine.oo";
import "core/split_demo.oo";
import "render/split_json.oo";
import "ipc/json_field.oo";

fn build_error(id: String, code: Int, msg: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":"
        + to_string(code) + ",\"message\":\"" + json_escape(msg) + "\"}}\n";
}

fn build_tool_result(id: String, text: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\""
        + json_escape(text) + "\"}]}}\n";
}

pub fn render_mcp_init(id: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id
        + ",\"result\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"oocsplt\",\"version\":\"0.2.0\"}}}\n";
}

pub fn render_mcp_tools_list(id: String) -> String {
    let mut out: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"tools\":[";
    out = out + "{\"name\":\"csplt_split\",\"description\":\"Split file or string data into context chunks based on patterns.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"path\":{\"type\":\"string\"},\"pattern\":{\"type\":\"string\"}}}}";
    out = out + ",{\"name\":\"csplt_preview\",\"description\":\"Preview chunk line bounds and byte counts without writing to disk.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"pattern\":{\"type\":\"string\"}}}}";
    out = out + ",{\"name\":\"csplt_by_lines\",\"description\":\"Split text into sections at specified line numbers.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"lines\":{\"type\":\"string\"}},\"required\":[\"lines\"]}}";
    out = out + ",{\"name\":\"csplt_by_pattern\",\"description\":\"Split text into sections matching a delimiter pattern.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"pattern\":{\"type\":\"string\"}},\"required\":[\"pattern\"]}}";
    out = out + ",{\"name\":\"csplt_demo\",\"description\":\"Return synthetic multi-chapter context splitting showcase.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}";
    out = out + "]}}\n";
    return out;
}

pub fn handle_mcp_call(
    fr: &FsReadCap,
    id: String,
    tool_name: String,
    req: String
) -> String {
    if tool_name == "csplt_split" || tool_name == "csplt_preview" {
        let path: String = extract_json_str(req, "path");
        let raw_data: String = extract_json_str(req, "data");
        let pat_str: String = extract_json_str(req, "pattern");
        let content: String = if chars_len(path) > 0 {
            let r: Result[String, String] = read_file(fr, path);
            match r { Ok(v) => v, Err(_) => raw_data }
        } else if chars_len(raw_data) > 0 {
            raw_data
        } else {
            build_demo_document()
        };

        let mut toks: List[String] = list_new();
        if chars_len(pat_str) > 0 {
            toks = list_push(toks, pat_str);
            toks = list_push(toks, "{*}");
        } else {
            toks = list_push(toks, "/^# Chapter/");
            toks = list_push(toks, "{*}");
        }

        let pats: List[SplitPattern] = parse_pattern_list(toks);
        let mut cfg: SplitConfig = default_split_config();
        cfg.dry_run = true;
        let res: SplitResult = execute_split(content, pats, cfg);
        return build_tool_result(id, result_to_json(res));
    }

    if tool_name == "csplt_by_lines" {
        let raw_data: String = extract_json_str(req, "data");
        let lines_str: String = extract_json_str(req, "lines");
        let content: String = if chars_len(raw_data) > 0 { raw_data } else { build_demo_document() };
        let mut toks: List[String] = list_new();
        toks = list_push(toks, lines_str);
        let pats: List[SplitPattern] = parse_pattern_list(toks);
        let mut cfg: SplitConfig = default_split_config();
        cfg.dry_run = true;
        let res: SplitResult = execute_split(content, pats, cfg);
        return build_tool_result(id, result_to_json(res));
    }

    if tool_name == "csplt_by_pattern" {
        let raw_data: String = extract_json_str(req, "data");
        let pat_str: String = extract_json_str(req, "pattern");
        let content: String = if chars_len(raw_data) > 0 { raw_data } else { build_demo_document() };
        let mut toks: List[String] = list_new();
        toks = list_push(toks, pat_str);
        toks = list_push(toks, "{*}");
        let pats: List[SplitPattern] = parse_pattern_list(toks);
        let mut cfg: SplitConfig = default_split_config();
        cfg.dry_run = true;
        let res: SplitResult = execute_split(content, pats, cfg);
        return build_tool_result(id, result_to_json(res));
    }

    if tool_name == "csplt_demo" {
        let res: SplitResult = build_demo_result();
        return build_tool_result(id, demo_to_json(res));
    }

    return build_error(id, -32601, "Unknown tool: " + tool_name);
}

pub fn handle_mcp_message(fr: &FsReadCap, req: String) -> String {
    let id_str: String = extract_json_str(req, "id");
    let id: String = if chars_len(id_str) > 0 { "\"" + id_str + "\"" } else { "1" };
    let method: String = extract_json_str(req, "method");

    if method == "initialize" {
        return render_mcp_init(id);
    }
    if method == "notifications/initialized" {
        return "";
    }
    if method == "tools/list" {
        return render_mcp_tools_list(id);
    }
    if method == "tools/call" {
        let tool_name: String = extract_json_str(req, "name");
        return handle_mcp_call(fr, id, tool_name, req);
    }
    if method == "shutdown" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}\n";
    }
    return build_error(id, -32601, "Method not found: " + method);
}

pub fn run_mcp_server(fr: &FsReadCap) {
    let mut buf: String = "";
    let mut running: Bool = true;
    while running {
        let r: Result[String, String] = oo_read_stdin_chunk(fr, 4096);
        if !r.is_ok() {
            running = false;
        } else {
            let chunk: String = match r { Ok(s) => s, Err(_) => "" };
            if chars_len(chunk) == 0 {
                running = false;
            } else {
                buf = buf + chunk;
                let mut nl_pos: Int = str_index_of(buf, "\n");
                while nl_pos >= 0 {
                    let line: String = str_slice(buf, 0, nl_pos);
                    buf = str_slice(buf, nl_pos + 1, chars_len(buf));
                    let trimmed: String = str_trim(line);
                    if chars_len(trimmed) > 0 {
                        let resp: String = handle_mcp_message(fr, trimmed);
                        if chars_len(resp) > 0 {
                            print(resp);
                        }
                    }
                    nl_pos = str_index_of(buf, "\n");
                }
            }
        }
    }
}
