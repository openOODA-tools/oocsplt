// # oocsplt Render Subsystem Unit Tests
//
// Logline: Verification anchors for terminal visual rendering and JSON serialization of split chunks.
//
// Setup: Executes themed render passes and JSON structure validations against synthetic chunk sets.
//
// Beats:
//   1. Verify theme palette resolution and fallback behavior.
//   2. Verify POSIX byte tallies and chunk summary card rendering.
//   3. Verify JSON serialization of chunks and aggregate result models.
//   4. Export unified render test harness.

import "core/split_types.oo";
import "core/split_demo.oo";
import "render/split_theme.oo";
import "render/split_view.oo";
import "render/split_json.oo";

pub fn test_themes() -> Bool {
    let mono: ThemePalette = get_theme("monochrome");
    if mono.bold != "" {
        return false;
    }
    let def_th: ThemePalette = get_theme("default");
    if chars_len(def_th.bold) == 0 {
        return false;
    }
    return true;
}

pub fn test_views() -> Bool {
    let mono: ThemePalette = get_theme("monochrome");
    let c: SplitChunk = SplitChunk {
        index: 0,
        filename: "xx00",
        start_line: 1,
        end_line: 10,
        byte_count: 140,
        line_count: 10,
        content: "test content\n"
    };

    let card: String = render_chunk_card(c, mono);
    if !str_contains(card, "xx00") {
        return false;
    }
    if !str_contains(card, "140") {
        return false;
    }

    let mut chunks: List[SplitChunk] = list_new();
    chunks = list_push(chunks, c);
    let res: SplitResult = SplitResult {
        chunks: chunks,
        total_bytes: 140,
        total_lines: 10,
        success: true,
        error_msg: ""
    };

    let posix: String = render_posix_output(res);
    if !str_contains(posix, "140\n") {
        return false;
    }

    let summary: String = render_split_summary(res, mono);
    if !str_contains(summary, "Extracted Chunks: 1") {
        return false;
    }

    return true;
}

pub fn test_json() -> Bool {
    let res: SplitResult = build_demo_result();
    let j: String = result_to_json(res);

    if !str_contains(j, "\"tool\": \"oocsplt\"") {
        return false;
    }
    if !str_contains(j, "\"chunks\":") {
        return false;
    }
    if !str_contains(j, "\"chunks_count\": 4") {
        return false;
    }

    return true;
}

pub fn run_render_tests() -> Bool {
    if !test_themes() {
        return false;
    }
    if !test_views() {
        return false;
    }
    if !test_json() {
        return false;
    }
    return true;
}
